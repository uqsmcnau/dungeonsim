# Godot 4 generated files (imports, class cache, editor state)
.godot/

# Export / build output
*.translation
export_presets.cfg
/build/
/exports/

# Editor and OS clutter
.DS_Store
Thumbs.db
*.tmp

# Background music: drop your own tracks into BGM/ -- they're not part of the
# repo (the folder itself is kept via .gitkeep). See scripts/music_player.gd.
/BGM/*
!/BGM/.gitkeep
